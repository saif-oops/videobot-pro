# ─── Required Telegram Bot Settings ──────────────────────────
# Telegram Bot Token — get from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (for admin access) — get from @userinfobot
# Multiple IDs can be comma-separated: 123456789,987654321
ADMIN_IDS=123456789

# ─── Razorpay Payment Settings (Optional in dev mode) ────────
# Get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional hosted payment link (e.g. Razorpay Payment Page)
RAZORPAY_PAYMENT_URL=

# ─── Direct UPI Settings (Optional) ──────────────────────────
# UPI ID for direct QR and intent payments
UPI_ID=
UPI_NAME=VideoBot Admin
UPI_QR_IMAGE=web/static/upi_qr.jpg

# ─── Deployment & Server Settings ────────────────────────────
# Public HTTPS URL of your deployment (leave blank for local polling mode)
# Example: https://videobot-production.up.railway.app
WEBHOOK_URL=

# Port for Starlette/Uvicorn server (automatically provided by cloud platforms like Railway/Render)
PORT=8080

# SQLite database file location (default: videobot.db)
DB_PATH=videobot.db

# ─── Bot Behavior ────────────────────────────────────────────
# Minutes after which delivered video messages auto-delete from chat (0 to disable)
AUTO_DELETE_MINUTES=30

# Optional custom Chrome/Chromium binary path for Linux VPS headless extraction
CHROME_BIN=

# ─── Web App / Player (Optional) ──────────────────────────────
# Public HTTPS URL of the video player for Telegram Mini App button
# Example: https://videobot-production.up.railway.app
WEB_APP_URL=

# ─── Force-Subscribe / FSUB (Optional) ─────────────────────────
# Username or numerical ID of your channel (Bot must be an Admin in the channel)
# Example: @MyUpdatesChannel or -1001234567890
FSUB_CHANNEL=
# Link for users to join (Optional, auto-generated if @channel_username is used)
FSUB_CHANNEL_URL=

# ─── Database Automated Backup (Optional) ─────────────────────
# Hours between automatic database backups sent to ADMIN_IDS (0 to disable)
BACKUP_INTERVAL_HOURS=24

