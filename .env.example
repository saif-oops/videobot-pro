# Telegram Bot Token — get from @BotFather
BOT_TOKEN=your_bot_token_here

# Your Telegram User ID (for admin access) — get from @userinfobot
ADMIN_IDS=123456789

# Razorpay credentials — get from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Your Railway app URL (leave blank for local polling mode)
# Example: https://videobot-production.up.railway.app
WEBHOOK_URL=

# Port (Railway sets this automatically)
PORT=8080
